# Porta em que o servidor HTTP vai escutar
PORT=3000

# Capacidade máxima de carga de cada drone, em kg
DRONE_MAX_WEIGHT_KG=5

# Alcance máximo de cada drone por carga de bateria, em km
DRONE_MAX_RANGE_KM=10

# Velocidade média do drone, em km/h (usada para estimar tempo de entrega)
DRONE_SPEED_KMH=40

# Persistência: "memory" (padrão) ou "sqlite".
# O modo sqlite grava em arquivo e exige Node 22.5+.
STORAGE=memory

# Arquivo do banco, usado apenas quando STORAGE=sqlite
DATABASE_FILE=drone-delivery.db
